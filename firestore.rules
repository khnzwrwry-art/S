rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Each user's own progress + agreement — only they can read/write it
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Community feed posts — anyone signed in can read; only the author can write/delete their own
    match /posts/{postId} {
      allow read: if request.auth != null;
      allow create: if request.auth != null && request.resource.data.authorId == request.auth.uid;
      allow update: if request.auth != null; // needed so others can add a "cheer" (like)
      allow delete: if request.auth != null && resource.data.authorId == request.auth.uid;
    }

    // Push notification tokens — only the owning user can read/write their own token
    match /fcmTokens/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }

    // Leaderboard entries — one per user, self-reported sales count + proof link.
    // Anyone signed in can read the board; only the owner can write their own entry.
    match /leaderboard/{userId} {
      allow read: if request.auth != null;
      allow write: if request.auth != null && request.auth.uid == userId;
    }
  }
}
